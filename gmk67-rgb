#!/usr/bin/python3
"""Luces del GMK67: interfaz GTK4 + libadwaita."""

import json
import math
import os
import sys
import threading
from dataclasses import asdict

sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

import gi
gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, GLib, Gtk

import gmk67
from colorpicker import ColorPickerButton

APP_ID = "dev.aloran.Gmk67Rgb"
PRESETS = [(255, 0, 0), (255, 128, 0), (255, 255, 0), (0, 255, 0),
           (0, 255, 255), (0, 0, 255), (128, 0, 255), (255, 255, 255)]
CONFIG_DIR = os.path.join(GLib.get_user_config_dir(), "gmk67-rgb")
CONFIG = os.path.join(CONFIG_DIR, "profile.json")
COLORS = os.path.join(CONFIG_DIR, "colors.json")


def load_profile():
    profile = gmk67.Profile()
    try:
        with open(CONFIG) as f:
            data = json.load(f)
        profile.active = data["active"]
        for value, e in data["effects"].items():
            profile.effects[int(value)] = gmk67.Effect(**{**e, "color": tuple(e["color"])})
    except (OSError, ValueError, KeyError, TypeError):
        pass
    # El efecto que tiene ahora el teclado manda sobre lo guardado
    try:
        with gmk67.Keyboard() as kb:
            effect = kb.read_effect()
        if effect.value in profile.effects:
            profile.effects[effect.value] = effect
            profile.active = effect.value
    except (gmk67.DeviceNotFound, gmk67.ProtocolError, OSError):
        pass
    return profile


def load_recent():
    try:
        with open(COLORS) as f:
            recent = [tuple(c) for c in json.load(f)]
        if len(recent) == len(PRESETS) and all(len(c) == 3 for c in recent):
            return recent
    except (OSError, ValueError, TypeError):
        pass
    return list(PRESETS)


def save_recent(recent):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(COLORS, "w") as f:
        json.dump(recent, f)


def save_profile(profile):
    os.makedirs(CONFIG_DIR, exist_ok=True)
    with open(CONFIG, "w") as f:
        json.dump({"active": profile.active,
                   "effects": {str(k): asdict(e) for k, e in profile.effects.items()}}, f, indent=1)


class Window(Adw.ApplicationWindow):
    def __init__(self, app):
        super().__init__(application=app, title="GMK67", default_width=460, default_height=640)
        self.profile = load_profile()
        self.recent = load_recent()
        self.loading = False

        self.toasts = Adw.ToastOverlay()
        view = Adw.ToolbarView()
        header = Adw.HeaderBar()
        self.apply_btn = Gtk.Button(label="Aplicar", css_classes=["suggested-action"])
        self.apply_btn.connect("clicked", self.on_apply)
        header.pack_end(self.apply_btn)
        view.add_top_bar(header)

        page = Adw.PreferencesPage()

        # Efecto
        group = Adw.PreferencesGroup(title="Efecto")
        self.mode_row = Adw.ComboRow(title="Modo", model=Gtk.StringList.new([m[1] for m in gmk67.MODES]))
        self.mode_row.connect("notify::selected", self.on_mode_changed)
        group.add(self.mode_row)
        page.add(group)

        # Color
        self.color_group = Adw.PreferencesGroup(title="Color")
        self.color_btn = ColorPickerButton(valign=Gtk.Align.CENTER)
        self.color_btn.connect("color-changed", self.on_changed)
        color_row = Adw.ActionRow(title="Color")
        color_row.add_suffix(self.color_btn)
        color_row.set_activatable_widget(self.color_btn)
        self.color_group.add(color_row)

        presets = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.NONE, max_children_per_line=8,
                              min_children_per_line=8, margin_top=6, margin_bottom=6,
                              margin_start=6, margin_end=6, homogeneous=True)
        self.swatches = []
        for i in range(len(self.recent)):
            presets.append(self.make_swatch(i))
        preset_row = Adw.PreferencesRow(activatable=False, child=presets)
        self.color_group.add(preset_row)

        self.random_row = Adw.SwitchRow(title="Colores aleatorios",
                                        subtitle="Ignora el color elegido")
        self.random_row.connect("notify::active", self.on_changed)
        self.color_group.add(self.random_row)
        page.add(self.color_group)

        # Animación
        group = Adw.PreferencesGroup(title="Ajustes")
        self.brightness_row, self.brightness = self.make_scale_row(group, "Brillo")
        self.speed_row, self.speed = self.make_scale_row(group, "Velocidad")
        self.dir_model = Gtk.StringList()
        self.dir_row = Adw.ComboRow(title="Dirección", model=self.dir_model)
        self.dir_row.connect("notify::selected", self.on_changed)
        group.add(self.dir_row)
        page.add(group)

        view.set_content(page)
        self.toasts.set_child(view)
        self.set_content(self.toasts)

        active_index = next((i for i, m in enumerate(gmk67.MODES) if m[0] == self.profile.active), 0)
        self.mode_row.set_selected(active_index)
        self.on_mode_changed()

    # --- widgets ---

    def make_scale_row(self, group, title):
        scale = Gtk.Scale.new_with_range(Gtk.Orientation.HORIZONTAL, 0, gmk67.MAX_LEVEL, 1)
        scale.set_hexpand(True)
        scale.set_draw_value(False)
        scale.set_size_request(200, -1)
        scale.connect("value-changed", self.on_changed)
        row = Adw.ActionRow(title=title)
        row.add_suffix(scale)
        group.add(row)
        return row, scale

    def make_swatch(self, i):
        """Círculo del historial; dibuja self.recent[i], que cambia al aplicar colores."""
        def draw(_area, cr, w, h):
            r = min(w, h) / 2
            cr.arc(w / 2, h / 2, r - 1, 0, 2 * math.pi)
            cr.set_source_rgb(*(c / 255 for c in self.recent[i]))
            cr.fill_preserve()
            cr.set_source_rgba(0, 0, 0, 0.3)
            cr.set_line_width(1)
            cr.stroke()

        area = Gtk.DrawingArea(content_width=28, content_height=28)
        area.set_draw_func(draw)
        btn = Gtk.Button(child=area, css_classes=["flat", "circular"], halign=Gtk.Align.CENTER)
        btn.connect("clicked", lambda _b: (self.color_btn.set_color(self.recent[i]), self.on_changed()))
        self.swatches.append((btn, area))
        self.refresh_swatch(i)
        return btn

    def refresh_swatch(self, i):
        btn, area = self.swatches[i]
        btn.set_tooltip_text("#%02x%02x%02x" % self.recent[i])
        area.queue_draw()

    def remember_color(self, color):
        self.recent = [color] + [c for c in self.recent if c != color][:len(PRESETS) - 1]
        save_recent(self.recent)
        for i in range(len(self.swatches)):
            self.refresh_swatch(i)

    # --- estado ---

    def current_mode(self):
        return gmk67.MODES[self.mode_row.get_selected()]

    def on_mode_changed(self, *_):
        value, _name, has_color, has_speed, dir_kind = self.current_mode()
        effect = self.profile.effects[value]
        self.loading = True

        self.color_group.set_visible(has_color)
        self.color_btn.set_color(effect.color)
        self.random_row.set_active(effect.random)

        self.brightness.set_value(effect.brightness)
        self.brightness_row.set_visible(value != 0x00)
        self.speed_row.set_visible(has_speed)
        self.speed.set_value(effect.speed)

        directions = gmk67.DIRECTIONS.get(dir_kind, [])
        self.dir_model.splice(0, self.dir_model.get_n_items(), [d[1] for d in directions])
        self.dir_row.set_visible(bool(directions))
        raw = [d[0] for d in directions]
        self.dir_row.set_selected(raw.index(effect.direction) if effect.direction in raw else 0)

        self.loading = False
        self.on_changed()

    def on_changed(self, *_):
        if self.loading:
            return
        value, _name, has_color, has_speed, dir_kind = self.current_mode()
        effect = self.profile.effects[value]
        effect.color = self.color_btn.get_color()
        effect.random = self.random_row.get_active()
        effect.brightness = int(self.brightness.get_value())
        effect.speed = int(self.speed.get_value())
        directions = gmk67.DIRECTIONS.get(dir_kind)
        effect.direction = directions[self.dir_row.get_selected()][0] if directions else 0
        self.profile.active = value

    def on_apply(self, _btn):
        self.apply_btn.set_sensitive(False)
        save_profile(self.profile)
        effect = self.profile.effects[self.profile.active]
        if self.current_mode()[2] and not effect.random:
            self.remember_color(effect.color)

        def worker():
            try:
                with gmk67.Keyboard() as kb:
                    kb.set_effect(self.profile.effects[self.profile.active])
                msg = "Aplicado"
            except gmk67.DeviceNotFound as e:
                msg = str(e)
            except gmk67.ProtocolError as e:
                msg = str(e)
            except PermissionError:
                msg = "Sin permiso sobre el teclado: instala la regla udev (install.sh)"
            except OSError as e:
                msg = f"Error al hablar con el teclado: {e.strerror or e}"
            GLib.idle_add(self.done, msg)

        threading.Thread(target=worker, daemon=True).start()

    def done(self, msg):
        self.apply_btn.set_sensitive(True)
        self.toasts.add_toast(Adw.Toast(title=msg, timeout=3))


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID)

    def do_activate(self):
        win = self.get_active_window() or Window(self)
        win.present()


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
